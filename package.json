{
  "name": "a2ui-react-native",
  "version": "0.1.0",
  "description": "A2UI v1.0 React Native renderer using the official A2UI core",
  "keywords": [
    "a2ui",
    "react-native",
    "ai",
    "agent",
    "ui",
    "google",
    "declarative-ui",
    "agent-ui"
  ],
  "homepage": "https://github.com/sivamrudram-eng/a2ui-react-native#readme",
  "bugs": {
    "url": "https://github.com/sivamrudram-eng/a2ui-react-native/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sivamrudram-eng/a2ui-react-native.git"
  },
  "license": "Apache-2.0",
  "author": "Barathwaj Ramamoorthy <rbarathwaj@gmail.com>",
  "type": "module",
  "main": "lib/index.js",
  "module": "lib/index.js",
  "react-native": "src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "react-native": "./src/index.ts",
      "default": "./lib/index.js"
    },
    "./v1": {
      "types": "./lib/v1/index.d.ts",
      "react-native": "./src/v1/index.ts",
      "default": "./lib/v1/index.js"
    },
    "./core": {
      "types": "./vendor/a2ui-core/index.d.ts",
      "default": "./vendor/a2ui-core/index.js"
    }
  },
  "types": "lib/index.d.ts",
  "files": [
    "src",
    "lib",
    "vendor/a2ui-core"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test:metro": "node scripts/test-metro.cjs",
    "vendor:core": "node scripts/vendor-a2ui-core.mjs"
  },
  "devDependencies": {
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-community/slider": "4.5.7",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.2.0",
    "@types/react-test-renderer": "18.0.7",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.7.0",
    "react": "18.2.0",
    "react-native": "0.73.0",
    "react-native-svg": "15.8.0",
    "react-native-video": "6.18.0",
    "react-test-renderer": "18.2.0",
    "ts-jest": "^29.4.6",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "@react-native-community/datetimepicker": ">=8.4.0 <9",
    "@react-native-community/slider": ">=4.5.0 <5",
    "react": ">=18.0.0",
    "react-native": ">=0.73.0",
    "react-native-svg": ">=15.8.0 <16",
    "react-native-video": ">=6.18.0 <7"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    },
    "react-native": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@preact/signals-core": "1.14.2",
    "react-native-url-polyfill": "2.0.0",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  }
}
